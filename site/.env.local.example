# Interview agent — copy this file to .env.local and fill in the values.
# .env.local is gitignored. NEVER prefix any of these with NEXT_PUBLIC_, which
# would ship them to the browser.

# platform.claude.com → API keys.
# ⚠️ Before creating the key: Organization settings → Billing → buy the $5
# minimum, leave AUTO-RELOAD OFF, then set a monthly spend limit with an alert
# at 50%. That spend limit is the actual guarantee the bill can't run away;
# everything in lib/agent-guard.ts only shapes the honest visitor's experience.
ANTHROPIC_API_KEY=

# elevenlabs.io → profile → API key. Free tier, ~10,000 characters/month.
# When the quota runs out /api/speak returns 429, the 🔊 buttons disappear and
# the text agent carries on. Nothing breaks and nothing gets charged.
ELEVENLABS_API_KEY=

# Any long random string. Signs the session tokens that gate /api/ask and
# /api/speak. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_SESSION_SECRET=
